# 이 파일을 .env로 복사하고 값을 적습니다. .env는 Git에서 제외됩니다.
# 빈 값(공백만 있는 값 포함)은 없는 것으로 봅니다.

# 텍스트 모델의 API 키(필수)
OPENAI_API_KEY=
# 텍스트 모델의 주소. 비우면 OpenAI 기본 주소
OPENAI_BASE_URL=
# 텍스트 모델 이름. 작업 파일과 설정 파일의 model이 이 값보다 앞섬
OPENAI_MODEL=
# 비전 모델 이름. 적으면 텍스트 모델에게 그림을 보내지 않고 비전 모델에게 묻는 나눈 방식이 됨
VISION_MODEL=
# 비전 모델의 API 키. 비우면 OPENAI_API_KEY를 씀(VISION_MODEL 없이 적으면 실행이 거절됨)
VISION_API_KEY=
# 비전 모델의 주소. 비우면 OPENAI_BASE_URL을 씀(VISION_MODEL 없이 적으면 실행이 거절됨)
VISION_BASE_URL=

# agent-desktop.exe의 절대 경로. 비우면 저장소의 target\release, target\debug 순으로 찾음
AGENT_DESKTOP_BIN=
# 설정 파일의 경로. 비우면 examples\llm-agent\settings.local.yaml (상대 경로는 실행하는 폴더 기준)
AGENT_SETTINGS=
# 지식 폴더. 명령줄 --knowledge-dir과 설정 파일의 knowledge_dir이 이 값보다 앞섬. 비우면 examples\llm-agent\knowledge
AGENT_KNOWLEDGE_DIR=
# 프로필 이름(예: company, home). 적으면 .env.<이름>을 이 파일보다 먼저 읽음. 명령줄 --profile이 이 값보다 앞섬
AGENT_PROFILE=
